{
  "name": "Censer.5-teacher",
  "seed": 1337,
  "max_chars": 500,
  "max_seq_len": 256,
  "tokenizer": {
    "vocab_size": 4096,
    "min_frequency": 2,
    "corpus_samples": 200000
  },
  "model": {
    "n_layers": 8,
    "n_heads": 8,
    "d_model": 320,
    "d_ff": 1280,
    "dropout": 0.1,
    "tie_embeddings": true
  },
  "data": {
    "val_fraction": 0.08,
    "test_fraction": 0.08,
    "max_per_source": 120000,
    "civil_comments_threshold": 0.5,
    "safe_ratio": 1.4,
    "curated_repeat": 5,
    "synthetic_safe": 16000,
    "hard_negative_ratio": 0.15,
    "borderline_ratio": 0.05
  },
  "train": {
    "batch_size": 96,
    "grad_accum_steps": 1,
    "epochs": 12,
    "lr": 0.002,
    "min_lr": 0.0001,
    "warmup_steps": 300,
    "weight_decay": 0.1,
    "grad_clip": 1.0,
    "eval_every_steps": 500,
    "num_workers": 4,
    "amp": true,
    "curated_weight": 4.0,
    "safe_curated_weight": 6.0,
    "augment_typo": 0.15,
    "distill": {
      "alpha": 0.5,
      "temperature": 4.0,
      "soft_file": "data/processed/train_soft.npy",
      "curated_boost": 0.75
    }
  }
}